APP_ENV=development
POSTGRES_DB=instalacam
POSTGRES_USER=instalacam
POSTGRES_PASSWORD=replace_with_a_long_unique_password
SECRET_KEY=replace_with_at_least_32_random_characters
FRONTEND_ORIGINS=http://localhost,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_14_character_minimum_password
WOMPPI_PUBLIC_KEY=
WOMPPI_PRIVATE_KEY=
WOMPPI_WEBHOOK_SECRET=
WHATSAPP_PROVIDER=off
WHATSAPP_NUMBER=[COMPLETAR]
# Conexión personal independiente: poner el mismo token aleatorio (32+ caracteres)
# en .env.whatsapp; nunca reutilizar una sesión/token de otro proyecto.
WHATSAPP_GATEWAY_URL=http://whatsapp:3210
WHATSAPP_GATEWAY_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
HTTP_PORT=8094
BACKEND_PORT=8001
# Volúmenes propios del grupo e-commerc-cam. Para reutilizar volúmenes ya existentes,
# indicar sus nombres y PLATFORM_VOLUMES_EXTERNAL=true; no copiar ni borrar datos.
PLATFORM_VOLUMES_EXTERNAL=false
PLATFORM_PG_VOLUME=e-commerc-cam_plataforma_pgdata
PLATFORM_UPLOADS_VOLUME=e-commerc-cam_plataforma_uploads
PLATFORM_AGREEMENTS_VOLUME=e-commerc-cam_plataforma_agreements
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# --- Despliegue serverless (Vercel + Supabase) ---
# SERVERLESS=true            # activa NullPool y modo de disco efimero
# AUTO_INIT_DB=true          # true solo en el primer despliegue; luego false
# DATABASE_URL=              # URI del pooler de Supabase (puerto 6543, modo transaccion)
# PRIVATE_FILES_DIR=/tmp/private_agreements
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_SERVICE_KEY=      # service_role key (Settings -> API) - NUNCA en el frontend
# SUPABASE_STORAGE_BUCKET=uploads
