# =============================================================================
# Entorno para despliegue serverless (Vercel + Supabase)
# =============================================================================
# Copia este archivo a .env.production y completa los valores
# cp .env.supabase .env.production

# --- Modo producción ---
APP_ENV=production
SERVERLESS=true
AUTO_INIT_DB=true              # true SOLO en el primer despliegue; luego cambia a false

# --- Base de datos (Supabase Pooler - puerto 6543, modo transacción) ---
# Obtén esta URL en: Supabase Dashboard > Project Settings > Database > Connection string > URI
# Usa el puerto 6543 (pooler), NO el 5432 (directo)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].pooler.supabase.com:6543/postgres

# --- JWT (panel admin) ---
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_un_secreto_de_32_caracteres_como_minimo

# --- CORS / Hosts ---
FRONTEND_ORIGINS=https://instalacam.vercel.app,https://www.tudominio.com
TRUSTED_HOSTS=instalacam-backend.vercel.app,*.vercel.app

# --- Admin inicial (primer seed) ---
INITIAL_ADMIN_EMAIL=admin@tudominio.com
INITIAL_ADMIN_PASSWORD=contraseña_muy_segura_18_caracteres

# --- Wompi (pagos) - https://wompi.co ---
WOMPPI_PUBLIC_KEY=pub_prod_xxxxxxxxxxxx
WOMPPI_PRIVATE_KEY=prv_prod_xxxxxxxxxxxx
WOMPPI_WEBHOOK_SECRET=sec_prod_xxxxxxxxxxxx

# --- WhatsApp (desactivar hasta configurar) ---
WHATSAPP_PROVIDER=off
WHATSAPP_NUMBER=[COMPLETAR]
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# --- Supabase Storage (imágenes) ---
# Supabase URL: Project Settings > API > Project URL
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
# Service role key: Project Settings > API > service_role key (NUNCA en frontend)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=uploads

# --- Archivos privados (PDF efímeros en serverless) ---
PRIVATE_FILES_DIR=/tmp/private_agreements
